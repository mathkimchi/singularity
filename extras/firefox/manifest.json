{
  "manifest_version": 3,
  "name": "Sonamu",
  "version": "0.1.0",
  "description": "One tab per window, and the page's url at the start of the window title, for Sonamu's sessions",
  "permissions": ["tabs"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "sonamu@mathkimchi.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
